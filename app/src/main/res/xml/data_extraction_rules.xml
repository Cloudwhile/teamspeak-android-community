<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Back up UI preferences only; exclude local databases and identity keys -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
