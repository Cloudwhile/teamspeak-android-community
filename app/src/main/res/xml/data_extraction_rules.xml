<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Allowlist mode: only UI preferences in files/datastore/ are extracted; databases & keys are excluded -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
